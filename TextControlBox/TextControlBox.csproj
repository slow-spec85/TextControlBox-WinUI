<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>TextControlBoxNS</RootNamespace>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<Platforms>x86;x64;ARM64</Platforms>
		<UseWinUI>true</UseWinUI>
		<WindowsSdkPackageVersion>10.0.19041.38</WindowsSdkPackageVersion>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<DocumentationFile></DocumentationFile>
		<PackageId>TextControlBox.WinUI.slow-spec85</PackageId>
		<Title>TextControlBox WinUI</Title>
		<MinVerTagPrefix>v</MinVerTagPrefix>
		<MinVerMinimumMajorMinor>2.0</MinVerMinimumMajorMinor>
		<MinVerAutoIncrement>patch</MinVerAutoIncrement>
		<MinVerDefaultPreReleaseIdentifiers>dev.0</MinVerDefaultPreReleaseIdentifiers>
		<Authors>Julius Kirsch, slow-spec85</Authors>
		<Product>TextControlBox WinUI</Product>
		<Description>A high-performance WinUI 3 text editor control for .NET 8 with Win2D viewport rendering, editing, selection, undo/redo, search and replace, syntax highlighting, line numbers, zoom, line and text-range decorations, virtualized gutter markers, and incremental document change notifications.</Description>
		<Copyright>2024-2026 Julius Kirsch</Copyright>
		<PackageProjectUrl>https://github.com/slow-spec85/TextControlBox-WinUI</PackageProjectUrl>
		<RepositoryUrl>https://github.com/slow-spec85/TextControlBox-WinUI</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>TextControlBox; TextEditor; WinUI; WinUI3; Win2D; .NET8; SyntaxHighlighting; LineDecorations; TextDecorations; Gutter</PackageTags>
		<PackageReleaseNotes>
			Retargeted the control to .NET 8 and Windows App SDK 2.2.
			Added universal line, gutter, and text-range decorations with viewport-aware rendering.
			Added incremental document change notifications and stateful multi-line syntax highlighting.
			Added per-control semantic syntax palettes and configurable editor layout extensions.
			Added detailed diagnostics when a syntax highlighting rule is quarantined after a regex timeout.
			Added fragment-aware state boundaries for syntax highlighting in diffs and other projections.
			Removed overlapping viewport-wide regex rules for HTML and XML comments.
		</PackageReleaseNotes>
		<PackageIcon>Icon1.png</PackageIcon>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
  <ItemGroup>
    <None Remove="Core\CoreTextControlBox.xaml" />
  </ItemGroup>
	<ItemGroup>
		<None Include="..\images\Icon1.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

  <ItemGroup>
      <PackageReference Include="Collections.Pooled" Version="1.0.82" />
      <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
	  <PackageReference Include="MinVer" Version="7.0.0">
		<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		<PrivateAssets>all</PrivateAssets>
	  </PackageReference>
	  <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
	  <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="Text\CoreTextControlBox.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
</Project>
